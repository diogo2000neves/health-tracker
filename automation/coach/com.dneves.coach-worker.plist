<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Coach's Sonnet worker.

  Every 5 minutes: ask the backend whether a generation is waiting, and if so answer
  it with the local `claude` CLI. Almost every run is a 204 and exits in under a
  second, so the polling is cheap.

  RunAtLoad means a Mac that wakes up mid-morning picks up whatever accumulated while
  it slept, which is the normal case rather than the exception — the backend's job
  queue exists precisely so that a sleeping laptop only delays the coach instead of
  breaking it.

  The environment is set HERE, in full. The previous generation of these agents
  inherited nothing and failed silently for days with "GEMINI_API_KEY is not
  configured" — launchd does not read your shell profile.

  Install:
    cp automation/coach/com.dneves.coach-worker.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$UID ~/Library/LaunchAgents/com.dneves.coach-worker.plist
  Check:
    launchctl print gui/$UID/com.dneves.coach-worker | head -20
    tail -f automation/coach/logs/worker.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dneves.coach-worker</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/dneves/personal/health-tracker/backend/venv/bin/python</string>
        <string>/Users/dneves/personal/health-tracker/automation/coach/worker.py</string>
        <string>--drain</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>INGEST_TOKEN</key>
        <string>REPLACE_WITH_INGEST_TOKEN</string>
        <key>HEALTH_BACKEND_URL</key>
        <string>https://health-tracker-ingest-myznjtlyrq-ew.a.run.app</string>
        <key>COACH_MODEL</key>
        <string>claude-sonnet-5</string>
        <key>COACH_EFFORT</key>
        <string>high</string>
        <key>CLAUDE_BIN</key>
        <string>/Users/dneves/.nvm/versions/node/v22.12.0/bin/claude</string>
        <key>PATH</key>
        <string>/Users/dneves/.nvm/versions/node/v22.12.0/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/dneves/personal/health-tracker/automation/coach/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/dneves/personal/health-tracker/automation/coach/logs/launchd.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
